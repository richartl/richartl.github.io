---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  width?: number;
  rotate?: number;
  style?: "clean" | "polaroid" | "xerox";
}

const {
  src,
  alt = "",
  caption = "",
  width = 220,
  rotate = 2,
  style = "polaroid",
} = Astro.props;
---

<figure
  class={`fz-right-photo fz-right-photo-${style}`}
  style={`--width:${width}px; --rotate:${rotate}deg`}
>
  <img src={src} alt={alt} loading="lazy" />

  {caption && (
    <figcaption>{caption}</figcaption>
  )}
</figure>

<style>
  .fz-right-photo {
    float: right;
    width: min(var(--width), 42%);
    margin: 0.5rem 0 1.5rem 2rem;

    transform: rotate(var(--rotate));

    position: relative;
    z-index: 1;

    color: #111;
  }

  .fz-right-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .fz-right-photo figcaption {
    margin-top: 8px;

    font-family: "Courier New", monospace;
    font-size: 0.72rem;
    line-height: 1.3;

    text-align: center;
    text-transform: uppercase;
  }


  /* POLAROID */

  .fz-right-photo-polaroid {
    padding: 7px 7px 25px;

    background: #f3efe3;

    box-shadow:
      5px 6px 0 rgba(0, 0, 0, 0.85);
  }


  /* CLEAN */

  .fz-right-photo-clean img {
    border: 3px solid #111;

    box-shadow:
      5px 5px 0 rgba(0, 0, 0, 0.8);
  }


  /* XEROX */

  .fz-right-photo-xerox img {
    filter:
      grayscale(1)
      contrast(1.8)
      brightness(1.1);

    border: 4px solid #111;
  }

  .fz-right-photo-xerox figcaption {
    display: inline-block;

    background: #111;
    color: white;

    padding: 4px 8px;

    transform: rotate(-2deg);
  }


  /* MOBILE */

  @media (max-width: 650px) {
    .fz-right-photo {
      float: none;

      width: min(var(--width), 75%);

      margin: 2rem auto;

      transform:
        rotate(calc(var(--rotate) * 0.5));
    }
  }
</style>
