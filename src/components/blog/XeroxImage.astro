---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  rotate?: number;
}

const {
  src,
  alt = "",
  caption = "",
  rotate = -1,
} = Astro.props;
---

<figure
  class="fanzine-xerox"
  style={`--rotate: ${rotate}deg`}
>
  <div class="fanzine-xerox-image">
    <img src={src} alt={alt} loading="lazy" />
  </div>

  {caption && (
    <figcaption>
      {caption}
    </figcaption>
  )}
</figure>
