---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  rotate?: number;
  size?: "small" | "medium" | "large";
}

const {
  src,
  alt = "",
  caption = "",
  rotate = -2,
  size = "medium",
} = Astro.props;
---

<figure
  class={`fanzine-polaroid fanzine-size-${size}`}
  style={`--rotate: ${rotate}deg`}
>
  <img src={src} alt={alt} loading="lazy" />

  {caption && (
    <figcaption>
      {caption}
    </figcaption>
  )}
</figure>
