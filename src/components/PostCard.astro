---
const { post } = Astro.props;
const date = post.data.pubDate.toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});

const tapeStyles = ['tape-surf', 'tape-tape', 'tape-flare tape-r'];
---

<article class="flex h-full flex-col gap-4 rounded-lg border border-ink/15 bg-surface p-6 transition-colors hover:border-ink">
  <div class="flex flex-wrap gap-2">
    {post.data.tags.map((tag: string, i: number) => (
      <span class={`tape ${tapeStyles[i % tapeStyles.length]}`}>{tag}</span>
    ))}
  </div>
  <p class="mono text-xs font-bold uppercase tracking-wide text-ink/60">{date}</p>
  <h2 class="serif text-2xl font-bold leading-tight md:text-3xl">
    <a class="no-underline" href={`/blog/${post.id}/`}>{post.data.title}</a>
  </h2>
  <p class="text-ink/80">{post.data.description}</p>
  <a class="mt-auto w-fit font-bold text-surf underline decoration-2 underline-offset-4" href={`/blog/${post.id}/`}>
    Leer nota →
  </a>
</article>
