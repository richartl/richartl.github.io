---
import { withBase } from '@lib/paths';

const { project } = Astro.props;
const projectHref = withBase(`/proyectos/${project.id}/`);
---

<a
  href={projectHref}
  class="flex flex-col gap-3 rounded-lg border border-ink/15 bg-surface p-6 no-underline transition-colors hover:border-ink md:p-8"
>
  <span class={`tape w-fit ${project.data.kickerColor}`}>{project.data.kicker}</span>
  <h3 class="serif text-3xl font-bold leading-tight md:text-4xl">{project.data.title}</h3>
  <p class="text-ink/80">{project.data.description}</p>
  <span class="mt-auto w-fit font-bold text-surf underline decoration-2 underline-offset-4">
    Ver proyecto →
  </span>
</a>
