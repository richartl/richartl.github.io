---
import { getCollection, render } from 'astro:content';
import Base from '@layouts/Base.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((project) => !project.data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title} description={project.data.description}>
  <main class="min-h-screen p-5 md:p-8">
    <article class="mx-auto max-w-5xl">
      <header class="rounded-lg border border-ink/15 bg-surface p-6 md:p-10">
        <span class={`tape ${project.data.kickerColor}`}>{project.data.kicker}</span>
        <h1 class="serif mt-4 text-4xl font-black leading-tight tracking-tight md:text-6xl">
          {project.data.title}
        </h1>
        <p class="mt-5 max-w-3xl text-lg text-ink/80 md:text-xl">{project.data.description}</p>
      </header>

      <div class="prose prose-lg mt-10 max-w-none rounded-lg border border-ink/15 bg-surface p-6 md:p-10">
        <Content />
      </div>
    </article>
  </main>
</Base>
