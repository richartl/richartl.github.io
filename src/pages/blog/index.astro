---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import PostCard from '@components/PostCard.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title="Notas" description="Notas y experimentos de Ricardo Pérez.">
  <main class="min-h-screen bg-[#86efac] p-5 md:p-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 border-[3px] border-black bg-white p-6 brutal-shadow">
        <p class="mono text-sm font-black uppercase">ARCHIVE</p>
        <h1 class="mt-3 text-6xl font-black uppercase tracking-[-0.06em] md:text-8xl">Notas</h1>
        <p class="mt-4 max-w-3xl text-xl font-bold">
          Lo que voy entendiendo, probando, rompiendo y volviendo a intentar.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </main>
</Base>
