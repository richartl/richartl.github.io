---
import { getCollection, render } from 'astro:content';
import { Pill } from '@eliancodes/brutal-ui';
import Base from '@layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const date = post.data.pubDate.toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={post.data.title} description={post.data.description}>
  <main class="min-h-screen bg-[#f8a8d4] p-5 md:p-8">
    <article class="mx-auto max-w-5xl">
      <header class="border-[3px] border-black bg-white p-6 brutal-shadow md:p-10">
        <div class="mb-5 flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => <Pill>{tag}</Pill>)}
        </div>
        <p class="mono text-sm font-black uppercase">{date} / {post.data.author}</p>
        <h1 class="mt-5 text-5xl font-black leading-[.9] tracking-[-0.055em] md:text-8xl">
          {post.data.title}
        </h1>
        <p class="mt-6 max-w-3xl text-xl font-bold md:text-2xl">{post.data.description}</p>
      </header>

      <div class="prose prose-lg mt-10 max-w-none border-[3px] border-black bg-white p-6 brutal-shadow md:p-10">
        <Content />
      </div>
    </article>
  </main>
</Base>
