---
import { getCollection, render } from 'astro:content';
import Base from '@layouts/Base.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const date = post.data.pubDate.toLocaleDateString('es-MX', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const tapeStyles = ['tape-surf', 'tape-tape', 'tape-flare tape-r'];
---

<Base title={post.data.title} description={post.data.description}>
  <main class="min-h-screen p-5 md:p-8">
    <article class="mx-auto max-w-5xl">
      <header class="rounded-lg border border-ink/15 bg-surface p-6 md:p-10">
        <div class="mb-5 flex flex-wrap gap-2">
          {post.data.tags.map((tag: string, i: number) => (
            <span class={`tape ${tapeStyles[i % tapeStyles.length]}`}>{tag}</span>
          ))}
        </div>
        <p class="mono text-xs font-bold uppercase tracking-wide text-ink/60">{date} / {post.data.author}</p>
        <h1 class="serif mt-4 text-4xl font-black leading-tight tracking-tight md:text-6xl">
          {post.data.title}
        </h1>
        <p class="mt-5 max-w-3xl text-lg text-ink/80 md:text-xl">{post.data.description}</p>
      </header>

      <div class="prose prose-lg mt-10 max-w-none rounded-lg border border-ink/15 bg-surface p-6 md:p-10">
        <Content />
      </div>
    </article>
  </main>
</Base>
