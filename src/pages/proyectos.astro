---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/PageHeader.astro';

const projects = [
  {
    id: 'repository-security-scanner',
    tape: 'tape-surf',
    kicker: 'Build_001',
    title: 'Repository Security Scanner',
    description: 'SAST, SCA, DAST, imágenes y manifiestos de Kubernetes en un mismo flujo.',
  },
  {
    id: 'openshift-monitoring',
    tape: 'tape-tape',
    kicker: 'Build_002',
    title: 'OpenShift Monitoring',
    description: 'Experimentos para automatizar instrumentación y monitoreo de aplicaciones.',
  },
];
---

<Base title="Proyectos" description="Proyectos personales de Ricardo Pérez.">
  <main class="min-h-screen p-5 md:p-8">
    <div class="mx-auto max-w-7xl">
      <PageHeader
        kicker="Build"
        kickerTape="tape-tape"
        title="Proyectos"
        subtitle="Cosas que construyo para aprender, romper y volver a intentar."
      />

      <div class="grid gap-8 lg:grid-cols-2">
        {projects.map((project) => (
          <div id={project.id} class="rounded-lg border border-ink/15 bg-surface p-6 md:p-8">
            <span class={`tape ${project.tape}`}>{project.kicker}</span>
            <h2 class="serif mt-4 text-3xl font-bold leading-tight md:text-4xl">{project.title}</h2>
            <p class="mt-3 text-ink/80">{project.description}</p>
          </div>
        ))}
      </div>
    </div>
  </main>
</Base>
