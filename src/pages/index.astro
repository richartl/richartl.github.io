---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import PostCard from '@components/PostCard.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const focusTags = [
  { label: 'SRE', tape: 'tape-surf' },
  { label: 'DevOps', tape: 'tape-tape' },
  { label: 'Software', tape: 'tape-flare tape-r' },
  { label: 'Música', tape: 'tape-ink' },
];
---

<Base
  title="Inicio"
  description="Archivo personal de Ricardo Pérez: SRE, DevOps, software, música y proyectos."
>
  <main>
    <section class="border-b border-ink/15 p-5 md:p-8">
      <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-3">
        <div class="rounded-lg border border-ink/15 bg-surface p-6 lg:col-span-2 md:p-10">
          <div class="flex min-h-[380px] flex-col justify-between gap-8">
            <div class="flex flex-wrap gap-3">
              {focusTags.map((tag) => <span class={`tape ${tag.tape}`}>{tag.label}</span>)}
            </div>
            <div>
              <p class="mono mb-3 text-sm font-bold uppercase tracking-wide text-ink/60">Archivo personal / 2026</p>
              <h1 class="serif max-w-4xl text-5xl font-black leading-[.95] tracking-tight sm:text-6xl md:text-7xl">
                Aprendo. Rompo.
                <span class="underline decoration-tape decoration-[6px] underline-offset-4">Documento.</span>
              </h1>
            </div>
            <p class="max-w-2xl text-lg text-ink/80 md:text-xl">
              Notas sobre sistemas, software, infraestructura, música y cosas que construyo.
            </p>
          </div>
        </div>

        <div class="flex flex-col gap-6">
          <div class="rounded-lg border border-ink/15 bg-surface p-6">
            <p class="mono text-xs font-bold uppercase tracking-wide text-ink/60">¿Qué es esto?</p>
            <h2 class="serif mt-3 text-3xl font-bold leading-tight">Un cuaderno técnico público.</h2>
            <p class="mt-3 text-ink/80">
              No intento tener todas las respuestas. Escribo para entender mejor lo que voy aprendiendo.
            </p>
          </div>

          <div class="rounded-lg border border-ink/15 bg-surface p-6">
            <p class="mono text-xs font-bold uppercase tracking-wide text-ink/60">Ahora mismo</p>
            <ul class="mt-3 space-y-2 text-ink/80">
              <li class="flex items-center gap-2"><span class="text-surf">→</span> SRE y observabilidad</li>
              <li class="flex items-center gap-2"><span class="text-tape">→</span> OpenShift</li>
              <li class="flex items-center gap-2"><span class="text-flare">→</span> DevSecOps</li>
              <li class="flex items-center gap-2"><span class="text-surf">→</span> Proyectos personales</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-ink/15 p-5 md:p-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-col justify-between gap-3 md:flex-row md:items-end">
          <div>
            <p class="mono text-xs font-bold uppercase tracking-wide text-ink/60">Note / Lab / Build</p>
            <h2 class="serif text-4xl font-black tracking-tight md:text-5xl">Últimas notas</h2>
          </div>
          <a
            href="/blog/"
            class="mono inline-flex w-fit items-center gap-2 rounded-full border border-ink px-4 py-2 text-sm font-bold uppercase tracking-wide transition-colors hover:border-tape hover:bg-tape hover:text-surface"
          >
            Ver todas →
          </a>
        </div>
        <div class="grid gap-8 lg:grid-cols-3">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>

    <section id="proyectos" class="border-b border-ink/15 p-5 md:p-8">
      <div class="mx-auto max-w-7xl">
        <p class="mono mb-6 text-xs font-bold uppercase tracking-wide text-ink/60">Build</p>
        <div class="grid gap-8 lg:grid-cols-2">
          <div class="rounded-lg border border-ink/15 bg-surface p-6 md:p-8">
            <span class="tape tape-surf">Build_001</span>
            <h2 class="serif mt-4 text-3xl font-bold leading-tight md:text-4xl">Repository Security Scanner</h2>
            <p class="mt-3 text-ink/80">SAST, SCA, DAST, imágenes y manifiestos de Kubernetes en un mismo flujo.</p>
          </div>
          <div class="rounded-lg border border-ink/15 bg-surface p-6 md:p-8">
            <span class="tape tape-tape">Build_002</span>
            <h2 class="serif mt-4 text-3xl font-bold leading-tight md:text-4xl">OpenShift Monitoring</h2>
            <p class="mt-3 text-ink/80">Experimentos para automatizar instrumentación y monitoreo de aplicaciones.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="sobre-mi" class="p-5 md:p-8">
      <div class="mx-auto max-w-7xl">
        <div class="rounded-lg border border-ink/15 bg-surface p-6 md:p-10">
          <div class="grid gap-8 lg:grid-cols-3">
            <div>
              <span class="tape tape-flare">About</span>
              <h2 class="serif mt-4 text-4xl font-black tracking-tight">Ricardo Pérez</h2>
            </div>
            <div class="lg:col-span-2">
              <p class="serif text-2xl leading-snug text-ink/90 md:text-3xl">
                Trabajo con infraestructura, software y plataformas. Este sitio es donde documento lo que aprendo,
                lo que construyo y las dudas que me van apareciendo en el camino.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
