---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Notas sobre sistemas, software, música y cosas que construyo.'
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Inicio', hover: 'hover:text-surf' },
  { href: '/blog/', label: 'Notas', hover: 'hover:text-tape' },
  { href: '/#proyectos', label: 'Proyectos', hover: 'hover:text-flare' },
  { href: '/#sobre-mi', label: 'Sobre mí', hover: 'hover:text-surf' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} · Ricardo Pérez</title>
  </head>
  <body>
    <header class="border-b border-ink/15 bg-surface">
      <div class="mx-auto flex max-w-7xl flex-col gap-4 p-4 md:flex-row md:items-center md:justify-between">
        <a href="/" class="serif text-2xl font-black tracking-tight no-underline">
          Ricardo Pérez
        </a>
        <nav class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm font-bold uppercase tracking-wide">
          {navLinks.map((link) => (
            <a
              class={`no-underline decoration-2 underline-offset-4 hover:underline ${link.hover}`}
              href={link.href}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <slot />

    <footer class="border-t border-ink/15 bg-surface p-4">
      <div class="mx-auto flex max-w-7xl flex-col justify-between gap-2 font-mono text-xs uppercase tracking-wide text-ink/60 md:flex-row">
        <span>Ricardo Pérez / México</span>
        <span>Notas, lab y cosas que construyo</span>
      </div>
    </footer>
  </body>
</html>
